# Database (Supabase Postgres)
# Pooled connection (transaction mode), port 6543. Used by the app at runtime.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection, port 5432. Used only by drizzle-kit for migrations.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Slack app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Crypto — 32 bytes, base64 encoded.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# App
APP_BASE_URL=http://localhost:3000
# Opt in only on a persistent host with dd-cli installed and authenticated.
DOORDASH_EXECUTOR=disabled
NODE_ENV=development
